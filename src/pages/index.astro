---
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import BlogPostPreview from '../components/BlogPostPreview.astro';

let title = 'soranchu.ninja | instagram';
let description = 'The perfect product for your aviation blog.';
let permalink = 'https://soranchu.ninja/';

let allPosts = await Astro.glob('./posts/*.md');
allPosts = allPosts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<html lang="en">
  <head>
    <BaseHead {title} {description} {permalink} image="https://soratabi.nekohack.me/assets/top.jpg" />

    <style>
      .header {
        z-index: 199;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 100%;
        background: #fff;
        transition: 200ms;
      }

      .latest {
        font-size: 2.5rem;
        font-weight: 700;
      }
    </style>
  </head>

  <body>
    <div class="header">
      <BlogHeader title={title} description={description} />
    </div>
    <div class="content">
      <div aria-label="Blog post list">
        <div class="grid">
          {allPosts.map((p) => <BlogPostPreview post={p} />)}
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  .header {
    z-index: 199;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    background: #fff;
    transition: 200ms;
  }

  .grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
</style>
