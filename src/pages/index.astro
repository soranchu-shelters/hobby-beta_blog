---
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import BlogPostPreview from '../components/BlogPostPreview.astro';

let title = 'soranchu.ninja | instagram';
let description = 'The perfect product for your aviation blog.';
let permalink = 'https://soranchu.ninja/';

let allPosts = await Astro.glob('./posts/*.md');
allPosts = allPosts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<html lang="en">
  <head>
    <BaseHead {title} {description} {permalink} />

    <style>
      body {
        padding: 0;
        margin: 0;
      }

      .header {
        z-index: 199;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 100%;
        background: #fff;
        transition: 200ms;
      }

      .grid {
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        padding: 8px 0;
      }

      .grid {
        border-bottom: 1px solid #e6f6f5;
      }

      @media(min-width: 768px) {
        .grid {
          padding: 8px 16px;
        }
      }
    </style>
  </head>

  <body>
    <div class="header">
      <BlogHeader title={title} description={description} />
    </div>
    <div class="content">
      <div class="grid" aria-label="Blog post list">
        {allPosts.map((p) => <BlogPostPreview post={p} />)}
      </div>
    </div>
  </body>
</html>
