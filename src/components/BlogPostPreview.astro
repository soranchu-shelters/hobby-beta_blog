---
import { Image } from '@astrojs/image/components'

export interface Props {
  post: {
    frontmatter: {
      author: string;
      authorTwitter: string;
      category: string;
      title: string;
      type: string;
      date: string;
      tags: string[];
      image: string;
    }
  }
}

const { post } = Astro.props
---

<div class="item">
  <a href={post.url}>
    {post.frontmatter.image && (
      <Image width="400" height="400" class="hero-image" loading="lazy" src={post.frontmatter.image} alt={post.frontmatter.title} />
    )}
  </a>
</div>

<style>
  .hero-image {
    padding: 0;
    margin-top: 0;
    margin-bottom: 2rem;
  }

  @media(min-width: 768px) {
    .hero-image {
      padding: 0;
      height: 320px;
      margin: 0;
      object-fit: cover;
      object-position: center;
    }
  }

  .item {
    padding: 0;
    text-align: center;
    overflow: hidden;
  }

  img {
    max-width: 100%;
    height: auto;
    box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.2);
  }

  a:hover img {
    box-shadow: 0px 10px 20px rgba(, 0, 0, 0.05);
  }

  p {
    text-align: left;
  }
</style>
